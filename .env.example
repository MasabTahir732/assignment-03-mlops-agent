MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
# Set the password printed by `docker compose logs airflow`, or supply a JWT.
AIRFLOW_PASSWORD=
AIRFLOW_TOKEN=
KUBE_NAMESPACE=mlops-demo
APP_VERSION=1.0.0
MODEL_PATH=models/model.joblib
# Cloud language understanding (optional); never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
# Optional local LLM; rules mode needs no download or API key.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
